{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/development.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__.*(create|update)_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/development.py\""
          }
        ]
      }
    ]
  }
}
